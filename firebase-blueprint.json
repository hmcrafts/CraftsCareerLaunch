    "RelationshipEdgeRecord": {
      "title": "RelationshipEdgeRecord",
      "description": "Owner-isolated typed relationship edge in the Evidence Relationship Graph linking workspace experience, evidence, skills, requirements, opportunities, learning items, contacts, and employers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "canonicalKey": { "type": "string", "minLength": 3, "maxLength": 400 },
        "sourceType": {
          "type": "string",
          "enum": ["experience", "evidence", "skill", "requirement", "opportunity", "learning", "contact", "employer"],
          "maxLength": 30
        },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 300 },
        "targetType": {
          "type": "string",
          "enum": ["experience", "evidence", "skill", "requirement", "opportunity", "learning", "contact", "employer"],
          "maxLength": 30
        },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetLabel": { "type": "string", "minLength": 1, "maxLength": 300 },
        "relationshipType": {
          "type": "string",
          "enum": [
            "demonstrates",
            "supports",
            "has_requirement",
            "requires",
            "teaches",
            "claims_affiliation_with",
            "confirmed_affiliation_with",
            "offered_by",
            "adjacent_to"
          ],
          "maxLength": 40
        },
        "requirementPriority": {
          "type": "string",
          "enum": ["Required", "Preferred", "N/A"],
          "maxLength": 20
        },
        "evidenceIds": { "type": "array", "description": "Bounded accessible evidence or private document IDs (<= 20)." },
        "rejectedEvidenceIds": { "type": "array", "description": "Bounded evidence IDs present when suggestion was rejected (<= 20)." },
        "status": {
          "type": "string",
          "enum": ["suggested", "confirmed", "rejected"],
          "maxLength": 20
        },
        "origin": {
          "type": "string",
          "enum": ["user", "document_extraction", "ai_suggestion"],
          "maxLength": 30
        },
        "explanationNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "canonicalKey",
        "sourceType",
        "sourceId",
        "sourceLabel",
        "targetType",
        "targetId",
        "targetLabel",
        "relationshipType",
        "requirementPriority",
        "evidenceIds",
        "rejectedEvidenceIds",
        "status",
        "origin",
        "explanationNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuthenticityReviewRecord": {
      "title": "AuthenticityReviewRecord",
      "description": "Owner-isolated Authenticity & Safety Review evaluating employer identity, opening authenticity, recruiter affiliation, sender/channel authenticity, and requested actions separately.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opportunityId": { "type": "string", "maxLength": 128 },
        "subjectLabel": { "type": "string", "minLength": 1, "maxLength": 240 },
        "officialEmployerDomain": { "type": "string", "maxLength": 255 },
        "reviewScope": { "type": "string", "minLength": 1, "maxLength": 400 },
        "overallStatus": {
          "type": "string",
          "enum": [
            "not_reviewed",
            "partially_corroborated",
            "unresolved_concerns",
            "high_risk_request_detected",
            "corroborated_within_stated_scope",
            "documented_impersonation_confirmation"
          ],
          "maxLength": 48
        },
        "dimensionAssessments": {
          "type": "object",
          "description": "Independent 5-dimension assessment map (employer_identity, opening_authenticity, recruiter_affiliation, sender_channel_authenticity, requested_action)."
        },
        "impersonationConfirmation": {
          "type": "object",
          "description": "Documented impersonation confirmation metadata requiring who confirmed it, how identity was established, and supporting artifact ID."
        },
        "userDecision": {
          "type": "string",
          "enum": [
            "undecided",
            "proceed_within_scope",
            "pause_until_verified",
            "decline_and_disengage"
          ],
          "maxLength": 32
        },
        "userDecisionNote": { "type": "string", "maxLength": 2000 },
        "liveResearchStatus": {
          "type": "string",
          "enum": ["not_requested", "available", "unavailable"],
          "maxLength": 20
        },
        "liveResearchSummary": { "type": "string", "maxLength": 2000 },
        "whatWasChecked": { "type": "array", "description": "Bounded plain-English summary strings of checks performed (<= 15)." },
        "whatRemainsUnknown": { "type": "array", "description": "Bounded plain-English summary strings of remaining unknowns (<= 15)." },
        "nextVerificationSteps": { "type": "array", "description": "Bounded actionable verification steps (<= 12)." },
        "artifacts": { "type": "array", "description": "Bounded ReviewArtifact maps (<= 25)." },
        "checks": { "type": "array", "description": "Bounded VerificationCheck maps (<= 20)." },
        "findings": { "type": "array", "description": "Bounded RiskFinding maps separating observed fact from interpretation (<= 40)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "opportunityId",
        "subjectLabel",
        "officialEmployerDomain",
        "reviewScope",
        "overallStatus",
        "dimensionAssessments",
        "impersonationConfirmation",
        "userDecision",
        "userDecisionNote",
        "liveResearchStatus",
        "liveResearchSummary",
        "whatWasChecked",
        "whatRemainsUnknown",
        "nextVerificationSteps",
        "artifacts",
        "checks",
        "findings",
        "createdAt",
        "updatedAt"
      ]
    }
  },
