{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated workspace owner's private profile, career constraints, onboarding wizard progress, sharing settings, and master resume summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "educationSummary": { "type": "string", "maxLength": 1000 },
        "rbtCertificationStatus": {
          "type": "string",
          "enum": ["unverified", "active", "inactive_or_expired"],
          "maxLength": 40
        },
        "rbtCertificationNote": { "type": "string", "maxLength": 1000 },
        "littleLeavesSoftwareUsed": { "type": "string", "maxLength": 300 },
        "otherExperienceNotes": { "type": "string", "maxLength": 2000 },
        "masterResumeText": { "type": "string", "maxLength": 30000 },
        "masterResumeUpdatedAt": { "type": "string", "maxLength": 40 },
        "profileVerifiedByNora": { "type": "boolean" },
        "constraints": { "type": "object", "description": "Career and compensation preferences map." },
        "settings": { "type": "object", "description": "Workspace preferences map." },
        "crmSimulation": { "type": "object", "description": "Synthetic CRM practice progress map." },
        "starterSeeded": { "type": "boolean" },
        "onboardingWizard": { "type": "object", "description": "Resumable 6-step first-login setup wizard state." },
        "sharingSettings": { "type": "object", "description": "Owner-controlled privacy and reviewer sharing settings (default: private)." },
        "inviterSuggestions": { "type": "array", "description": "Bounded unverified profile suggestions supplied by inviter (<= 10)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "fullName",
        "location",
        "educationSummary",
        "rbtCertificationStatus",
        "rbtCertificationNote",
        "littleLeavesSoftwareUsed",
        "otherExperienceNotes",
        "masterResumeText",
        "masterResumeUpdatedAt",
        "profileVerifiedByNora",
        "constraints",
        "settings",
        "crmSimulation",
        "starterSeeded",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Application-level administrator grant (grants invitation management only; never grants read/write access to private user workspaces).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "emailNormalized": { "type": "string", "minLength": 3, "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "grantedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "emailNormalized", "displayName", "grantedByUid", "createdAt", "updatedAt"]
    },
    "InvitationRecord": {
      "title": "InvitationRecord",
      "description": "Administrator-managed job-seeker workspace invitation storing SHA-256 token hash and email binding.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "visibilityScope": { "type": "string", "enum": ["admin"], "maxLength": 16 },
        "invitationType": { "type": "string", "enum": ["job_seeker"], "maxLength": 24 },
        "recipientDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "recipientEmail": { "type": "string", "minLength": 3, "maxLength": 254 },
        "recipientEmailNormalized": { "type": "string", "minLength": 3, "maxLength": 254 },
        "maskedRecipientEmail": { "type": "string", "minLength": 3, "maxLength": 254 },
        "personalMessage": { "type": "string", "maxLength": 500 },
        "inviterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "inviterDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "currentTokenHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "status": {
          "type": "string",
          "enum": ["pending_delivery", "sent", "delivery_failed", "expired", "revoked", "accepted"],
          "maxLength": 24
        },
        "deliveryChannel": {
          "type": "string",
          "enum": ["email_provider", "unconfigured", "manual_link"],
          "maxLength": 24
        },
        "deliveryProviderResult": { "type": "string", "maxLength": 500 },
        "manualLinkGenerated": { "type": "boolean" },
        "sendAttemptCount": { "type": "number" },
        "suggestedItems": { "type": "array", "description": "Bounded unverified inviter-supplied starting notes (<= 10, never sent in email)." },
        "createdAtIso": { "type": "string", "maxLength": 40 },
        "expiresAtIso": { "type": "string", "maxLength": 40 },
        "expiresAtEpochMs": { "type": "number" },
        "acceptedAtIso": { "type": "string", "maxLength": 40 },
        "acceptedByUid": { "type": "string", "maxLength": 128 },
        "revokedAtIso": { "type": "string", "maxLength": 40 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "visibilityScope",
        "invitationType",
        "recipientDisplayName",
        "recipientEmail",
        "recipientEmailNormalized",
        "maskedRecipientEmail",
        "personalMessage",
        "inviterUid",
        "inviterDisplayName",
        "currentTokenHash",
        "status",
        "deliveryChannel",
        "deliveryProviderResult",
        "manualLinkGenerated",
        "sendAttemptCount",
        "suggestedItems",
        "createdAtIso",
        "expiresAtIso",
        "expiresAtEpochMs",
        "acceptedAtIso",
        "acceptedByUid",
        "revokedAtIso",
        "idempotencyKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvitationTokenLookup": {
      "title": "InvitationTokenLookup",
      "description": "Non-listable SHA-256 token capability lookup storing masked metadata only (zero unmasked PII).",
      "type": "object",
      "properties": {
        "tokenHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "invitationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invitationType": { "type": "string", "enum": ["job_seeker"], "maxLength": 24 },
        "inviterDisplayName": { "type": "string", "maxLength": 120 },
        "maskedRecipientEmail": { "type": "string", "maxLength": 254 },
        "saltedEmailHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "tokenStatus": {
          "type": "string",
          "enum": ["active", "superseded", "revoked", "accepted"],
          "maxLength": 20
        },
        "expiresAtIso": { "type": "string", "maxLength": 40 },
        "expiresAtEpochMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "tokenHash",
        "invitationId",
        "invitationType",
        "inviterDisplayName",
        "maskedRecipientEmail",
        "saltedEmailHash",
        "tokenStatus",
        "expiresAtIso",
        "expiresAtEpochMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLogRecord": {
      "title": "AuditLogRecord",
      "description": "Immutable security and lifecycle audit log entry containing actor, target identifier, timestamp, and outcome without sensitive message contents.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "visibilityScope": { "type": "string", "enum": ["admin"], "maxLength": 16 },
        "eventType": {
          "type": "string",
          "enum": [
            "invitation_created",
            "invitation_send_attempted",
            "invitation_resent",
            "invitation_manual_link_generated",
            "invitation_revoked",
            "invitation_accepted",
            "workspace_created",
            "sharing_permission_changed",
            "account_deleted"
          ],
          "maxLength": 48
        },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "outcome": { "type": "string", "enum": ["success", "failure", "unconfigured"], "maxLength": 24 },
        "summaryCode": { "type": "string", "maxLength": 200 },
        "createdAtIso": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "visibilityScope",
        "eventType",
        "actorUid",
        "targetId",
        "outcome",
        "summaryCode",
        "createdAtIso",
        "createdAt"
      ]
    },
